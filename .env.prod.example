# ==============================================================================
# HRFlow PRODUCTION configuration.   Copy to D:/services/hrflow-prod/.env and fill in.
#
# This is the ONLY place production is configured. docker-compose.yml passes every variable
# below to the containers (no hidden values). NEVER commit the real file.
# Passwords: letters and digits only (they are placed in a URL).
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"
#
# Applying a change:   docker compose --env-file <this file> -f deploy/prod/docker-compose.yml up -d
#   (recreates only the containers whose values changed; no image rebuild needed)
# After changing code instead: add --build.
#
# Fixed by the container (NOT set here; see comments in docker-compose.yml and "Where things live" in RUNBOOK.md).
# HRFLOW_FILES_ROOT is a path INSIDE the container; the host folder is ${HRFLOW_DATA_DIR}/documents:
#   STORAGE_ENGINE=sql, DB_TYPE=postgres, POSTGRES_HOST=postgres, HRFLOW_FILES_ROOT=/data/documents,
#   LOG_FILE_PATH=/data/logs/hrflow.log, GOOGLE_CREDENTIALS_FILE=/run/secrets/google-credentials.json,
#   INVOICE_TEMPLATE_PATH, BILL_UPLOADS_DIR / FINANCE_UPLOADS_DIR (legacy fallbacks).
# ==============================================================================

# ---- Deployment (host) ----
# Host folder with documents/, logs/ and secrets/ (Google service account key: secrets/google-credentials.json).
HRFLOW_DATA_DIR=D:/services/hrflow-prod/data
# Image tag to run (git commit / version).
HRFLOW_VERSION=latest
# Public port of the web tier on this PC.
HRFLOW_HTTP_PORT=80

# ---- Application ----
ENVIRONMENT=production
SECRET_KEY=
TOKEN_EXPIRY_HOURS=12
SESSION_COOKIE_NAME=hrflow_session
GOOGLE_OAUTH_CLIENT_ID=
ALLOWED_WORKSPACE_DOMAIN=voyance.health
# CORS origins. Same-origin deployment needs only the public URL(s). "*" is rejected in production.
ALLOWED_ORIGINS=http://localhost
# Browser API base URL. Empty = same origin (nginx proxies /api). Set only if the API is on another host.
HRFLOW_API_BASE_URL=

# ---- PostgreSQL ----
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_USER=hrflow_app
POSTGRES_PASSWORD=
POSTGRES_DB=hrflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ---- Files ----
# "local" (volume under HRFLOW_DATA_DIR/documents) or "drive" (Google Drive; needs DRIVE_ROOT_FOLDER_ID + service account key).
FILE_STORAGE_BACKEND=local
DRIVE_ROOT_FOLDER_ID=

# ---- Google Sheets export ----
SPREADSHEET_ID=
SHEETS_CACHE_TTL_SECONDS=30

# ---- Finance ----
ENFORCE_MAKER_CHECKER=true
INVOICE_TEMPLATE_VERSION=v1

# ---- Logging ----
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ---- Backups (see deploy/prod/RUNBOOK.md) ----
# Long random passphrase that encrypts backups. Keep a copy in a password manager: without it backups cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_LOCAL_DIR=D:/services/hrflow-prod/backups
# Google Drive for Desktop synced folder (encrypted files only are written there).
BACKUP_DRIVE_DIR=
# Google Drive for Desktop synced folder for the unencrypted additive files clone.
FILES_CLONE_DIR=
# Number of newest backups kept in each location.
BACKUP_KEEP=30

# ==============================================================================
# HRFlow LOCAL DEVELOPMENT configuration.   Copy to .env (repo root) and fill in.
#
# This single file configures the backend (be/) when run locally. The backend reads it
# only when ENVIRONMENT is not "production". Real environment variables always win.
# Production uses .env.prod.example instead (same variable names).
# The browser (fe/) has its own tiny config: copy fe/config-example.js to fe/config.js.
# Secret files (Google service account key) live in ./secrets/ and are never committed.
# ==============================================================================

# ---- App ----
# "development" or "production". Production enforces strict checks (no CORS "*", Secure cookies).
ENVIRONMENT=development

# ---- Authentication & sessions ----
# REQUIRED. Signs the session JWT cookie. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
TOKEN_EXPIRY_HOURS=12
SESSION_COOKIE_NAME=hrflow_session

# ---- Google Sign-In ----
# OAuth 2.0 Web Client ID (Google Cloud Console > APIs & Services > Credentials). Also used by fe/config.js.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Restrict sign-in to one Google Workspace domain (e.g. voyance.health). Blank allows any Google account.
ALLOWED_WORKSPACE_DOMAIN=

# ---- CORS ----
# Comma-separated frontend origins, e.g. http://localhost:5173,http://localhost:8080. "*" is rejected in production.
ALLOWED_ORIGINS=*

# ---- Database ----
# HRFlow runs on SQL only; any other value is rejected at startup.
STORAGE_ENGINE=sql
# "sqlite" (local default) or "postgres"
DB_TYPE=sqlite
# SQLite (DB_TYPE=sqlite). Relative paths resolve against be/.
SQLITE_PATH=./hrflow.db
# PostgreSQL (DB_TYPE=postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hrflow
# Optional full URL; overrides the values above and must match DB_TYPE.
# DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ---- File storage ----
# Where HR documents and Document Hub files go:
#   "local": the filesystem under HRFLOW_FILES_ROOT (no Google Drive needed)
#   "drive": Google Drive (needs DRIVE_ROOT_FOLDER_ID and the service account below)
# Finance uploads (bills, cheques, statements, proofs) are always stored under HRFLOW_FILES_ROOT.
FILE_STORAGE_BACKEND=local
# Files root. Layout: employees/, Company Documents/, finance_bills/, finance_attachments/, _meta/.
# Defaults to be/storage. Prefer an absolute path; a relative one resolves against the working directory.
# HRFLOW_FILES_ROOT=
# Google Drive root folder (only when FILE_STORAGE_BACKEND=drive): the folder shared with the service account as Editor.
DRIVE_ROOT_FOLDER_ID=

# ---- Google service account & Sheets export ----
# Service account key (secret). Defaults to ./secrets/google-credentials.json at the repo root.
# GOOGLE_CREDENTIALS_FILE=
# Target Google Sheet for the export pipeline (ID from the sheet URL between /d/ and /edit).
SPREADSHEET_ID=
# In-memory cache for Sheets reads, seconds (0 disables).
SHEETS_CACHE_TTL_SECONDS=30

# ---- Finance ----
# Payroll maker-checker: when true a submitter cannot approve their own payroll run.
ENFORCE_MAKER_CHECKER=true
# .docx invoice template (relative to be/ or absolute) and its version label.
INVOICE_TEMPLATE_PATH=../docs/templates/us_invoice_template.docx
INVOICE_TEMPLATE_VERSION=v1

# ---- Logging ----
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/hrflow.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

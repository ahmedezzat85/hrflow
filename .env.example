# ==============================================================================
# HRFlow Environment Configuration Template (.env.example)
# Copy this file to be/.env and fill in your environment-specific values.
# ==============================================================================

# ---- App Environment ----
# "development" (default, local work) or "production" (enforces strict security checks).
ENVIRONMENT=development

# ---- Authentication & Session Tokens ----
# Secret key used to sign JWT session cookies issued after Google Sign-In.
# MUST be set explicitly to a secure random string in production.
SECRET_KEY=replace-with-a-long-random-string
TOKEN_EXPIRY_HOURS=12
SESSION_COOKIE_NAME=hrflow_session

# ---- Sign In With Google (OAuth 2.0) ----
# OAuth 2.0 Web Client ID from Google Cloud Console > APIs & Services > Credentials
# (Note: Frontend also uses this ID in config.js / window.HRFLOW_CONFIG)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Restrict sign-in to a specific Google Workspace domain (e.g., "voyance.health").
# Leave blank to allow any verified Google account.
ALLOWED_WORKSPACE_DOMAIN=

# ---- CORS & Network ----
# Comma-separated list of allowed frontend origins (e.g. "http://localhost:5173,http://localhost:8080").
# Use "*" for local development only.
ALLOWED_ORIGINS=*

# ---- Storage Engine & Relational Database ----
# Storage mode:
#   - "sheets" (default): Google Sheets is the primary system of record.
#   - "dual": Writes go to both Sheets (authoritative) and SQL (shadow replica).
#   - "sql": Relational SQL database is the primary system of record.
STORAGE_ENGINE=sheets

# Relational Database connection URL (PostgreSQL or SQLite):
#   - SQLite (local): sqlite:///./hrflow.db
#   - PostgreSQL: postgresql://user:password@localhost:5432/hrflow
DATABASE_URL=sqlite:///./hrflow.db

# ---- Google Sheets Database Access (Legacy / Primary in "sheets" mode) ----
# Path to downloaded Google Service Account JSON credentials key file
GOOGLE_CREDENTIALS_FILE=credentials.json

# The ID of the Google Sheet (found in the URL between /d/ and /edit)
SPREADSHEET_ID=your-google-spreadsheet-id

# In-memory cache TTL in seconds for get_all_records() reads per sheet tab (0 to disable)
SHEETS_CACHE_TTL_SECONDS=30

# ---- Google Drive Storage (Documents, Claims, Invoices) ----
# The ID of the Google Drive folder where employee documents and company files are stored
DRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id

# ---- Invoice Generation ----
# Path to the .docx invoice template file (relative or absolute)
INVOICE_TEMPLATE_PATH=../docs/templates/us_invoice_template.docx
INVOICE_TEMPLATE_VERSION=v1

# ---- Logging & Diagnostics ----
# Minimum log severity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/hrflow.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Copy to mcp_server/.env (gitignored). Never commit real values.

# HRFlow as seen from this PC. Not the public hostname: this call stays on the machine.
HRFLOW_BASE_URL=http://localhost:80

# Personal access token of the HRFlow user this server acts as. Make it on the HRFlow host:
#   python scripts/manage_api_tokens.py create --email <owner login> --name "claude mcp" --scopes mcp:read,mcp:stage
HRFLOW_API_TOKEN=

# The key claude.ai presents to this server. At least 32 random characters, different from the token:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HRFLOW_MCP_KEY=

# Port this server listens on (127.0.0.1 only); point the Cloudflare tunnel here.
MCP_PORT=8765

# Public hostname of the tunnel, e.g. hrflow-mcp.example.com (allowed in the Host check)
MCP_PUBLIC_HOST=

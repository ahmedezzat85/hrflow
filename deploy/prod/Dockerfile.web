# HRFlow web tier: builds the single-file frontend and serves it with nginx, proxying /api to the app.
# Build context: repository root. Build arg GOOGLE_CLIENT_ID is public (not a secret).
FROM node:20-alpine AS build
ARG GOOGLE_CLIENT_ID
WORKDIR /fe
COPY fe/package.json fe/package-lock.json ./
RUN npm ci
COPY fe/ ./
# Same-origin API: empty base URL makes the frontend call /api/... on its own host.
RUN printf 'window.HRFLOW_CONFIG = { API_BASE_URL: "", GOOGLE_CLIENT_ID: "%s" };\n' "$GOOGLE_CLIENT_ID" > config.js \
    && npm run build

FROM nginx:1.27-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/prod/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/prod/nginx/proxy.conf deploy/prod/nginx/security-headers.conf /etc/nginx/snippets/
COPY --from=build /fe/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/nginx-health || exit 1

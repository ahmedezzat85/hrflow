# HRFlow web tier: builds the single-file frontend and serves it with nginx, proxying /api to the app.
# Build context: repository root. No environment-specific value is baked in: config.js is generated at container start.
FROM node:20-alpine AS build
WORKDIR /fe
COPY fe/package.json fe/package-lock.json ./
RUN npm ci
COPY fe/ ./
# Placeholder only so the build can copy config.js; the real file is generated at container start.
RUN printf 'window.HRFLOW_CONFIG = { API_BASE_URL: "", GOOGLE_CLIENT_ID: "" };\n' > config.js \
    && npm run build

FROM nginx:1.27-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/prod/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/prod/nginx/proxy.conf deploy/prod/nginx/security-headers.conf /etc/nginx/snippets/
COPY --from=build /fe/dist /usr/share/nginx/html
COPY deploy/prod/scripts/web-config.sh /docker-entrypoint.d/40-hrflow-config.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-hrflow-config.sh && chmod +x /docker-entrypoint.d/40-hrflow-config.sh
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/nginx-health || exit 1

# HRFlow PRODUCTION environment. Copy to D:/services/hrflow-prod/.env and fill in.
# NEVER commit the real file. Use letters+digits only in passwords (they are placed in a URL).
# Generate secrets, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"

# Host folders (outside the repo)
HRFLOW_DATA_DIR=D:/services/hrflow-prod/data

# Image tag to run (set to the git commit / version you built)
HRFLOW_VERSION=latest

# Public port of the web tier on this PC
HRFLOW_HTTP_PORT=80

# --- Application ---
SECRET_KEY=
TOKEN_EXPIRY_HOURS=12
GOOGLE_OAUTH_CLIENT_ID=
ALLOWED_WORKSPACE_DOMAIN=voyance.health
# Origins allowed by CORS. Same-origin deployment needs only the public URL(s).
ALLOWED_ORIGINS=http://localhost

# --- PostgreSQL ---
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_USER=hrflow_app
POSTGRES_PASSWORD=
POSTGRES_DB=hrflow
